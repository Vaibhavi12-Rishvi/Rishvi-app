!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*
*.swp
*.swo
*~

# Angular
/.angular/
/.angular/cache
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings

# Testing
/coverage
*.spec.ts.snap
.nyc_output
karma.conf.js

# Environment files (keep templates)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build artifacts
*.tgz
*.log

# System files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.cache

# Documentation build
/docs/_build/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# dotenv environment variable files
.env.*.local

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

